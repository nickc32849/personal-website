---
// A single clickable project card. It receives one `project` object as a
// "prop" and links to that project's detail page. Written once here, reused
// on both the Home page (featured) and the Projects page.
const { project } = Astro.props;

// Map the controlled stage value to its pill color class.
const stageClass =
  {
    "In Progress": "is-progress",
    Complete: "is-complete",
    Concept: "is-concept",
  }[project.stage] ?? "";
---

<a class="project-card" href={`/projects/${project.slug}`}>
  <div class="project-thumb">
    {
      project.thumbnail ? (
        <img
          src={project.thumbnail}
          alt={project.title}
          loading="lazy"
          style={project.thumbnailPosition
            ? `object-position: ${project.thumbnailPosition}`
            : undefined}
        />
      ) : (
        "Project image"
      )
    }
  </div>
  <div class="project-body">
    {project.stage && <span class={`status-badge ${stageClass}`}>{project.stage}</span>}
    <h3 class="project-title">{project.title}</h3>
    <p class="project-blurb">{project.blurb}</p>
    {
      project.tags && project.tags.length > 0 && (
        <ul class="project-tags">
          {project.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )
    }
  </div>
</a>

<style>
  .project-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface-1);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(46, 139, 255, 0.55);
    box-shadow: 0 0 0 1px rgba(46, 139, 255, 0.25),
      0 16px 40px rgba(0, 0, 0, 0.45);
  }
  .project-thumb {
    aspect-ratio: 16 / 10;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    display: grid;
    place-items: center;
    color: var(--text-lo);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    overflow: hidden;
  }
  .project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* fill the card area, cropping without distortion */
  }
  .project-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .status-badge {
    margin-bottom: 0.7rem;
  }
  .project-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem; /* 20px */
    letter-spacing: -0.01em;
    color: var(--text-hi);
  }
  .project-blurb {
    color: var(--text-mid);
    font-size: 0.9375rem; /* 15px */
    margin-top: 0.4rem;
  }
  .project-tags {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .project-tags li {
    font-family: var(--font-mono);
    font-size: 0.656rem; /* 10.5px */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-lo);
    background: rgba(46, 139, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.22rem 0.5rem;
    transition: border-color 0.2s ease;
  }
  .project-tags li:hover {
    border-color: var(--accent);
  }
</style>
