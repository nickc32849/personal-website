---
// The top navigation bar. Written ONCE here, shown on every page via Base.astro.
// To add/remove/rename a nav item, just edit this list:
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/experience", label: "Experience" },
  { href: "/projects", label: "Projects" },
];

// Astro.url.pathname is the current page's URL path. We use it to highlight
// whichever link matches the page you're on.
const currentPath = Astro.url.pathname;
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">Nick Carpenter</a>
    <nav>
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* These styles are "scoped" — Astro automatically makes them apply ONLY
     to this component, so they can't accidentally affect other pages. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 14, 17, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    /* Full-width row: no max-width, just edge padding so the brand and links
       sit near the left/right corners of the page. */
    padding-inline: 1.5rem;
  }
  .nav-brand {
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-hi);
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem; /* 12px */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-lo);
    transition: color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--accent);
  }
  /* Current page sits at the high-contrast text level. */
  .nav-link[aria-current="page"] {
    color: var(--text-hi);
    font-weight: 500;
  }

  /* On narrow screens, let the links wrap neatly */
  @media (max-width: 480px) {
    .nav-inner {
      height: auto;
      flex-direction: column;
      gap: 0.5rem;
      padding-block: 0.75rem;
    }
  }
</style>
