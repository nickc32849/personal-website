---
// A PROJECT DETAIL PAGE — written once as a template. The [slug] in the
// filename makes this a "dynamic route": Astro generates one page per project.

import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Map the controlled stage value to its color class (pill + status value).
const stageClass =
  {
    "In Progress": "is-progress",
    Complete: "is-complete",
    Concept: "is-concept",
  }[project.stage] ?? "";

// `description` may be a single string or an array of paragraphs. Normalize to
// an array here so the template can just loop over it either way.
const paragraphs = Array.isArray(project.description)
  ? project.description
  : [project.description];

// Sections render around the description prose: those without `afterDescription`
// go above it, those with it go below.
const sections = project.sections ?? [];
const sectionsBefore = sections.filter((s) => !s.afterDescription);
const sectionsAfter = sections.filter((s) => s.afterDescription);
---

<Base title={`${project.title} — Nick Carpenter`}>
  <section class="section">
    <div class="container project-detail">
      <a class="back-link" href="/projects">← Back to Projects</a>

      <h1 class="detail-title">{project.title}</h1>

      {project.stage && <span class={`status-badge ${stageClass}`}>{project.stage}</span>}

      {
        project.tags && project.tags.length > 0 && (
          <ul class="project-tags">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }

      <!-- Compact metadata strip: small labels, folds in Tools and Status -->
      <dl class="meta-strip">
        {
          project.type && (
            <div class="meta-row">
              <dt>Type</dt>
              <dd>{project.type}</dd>
            </div>
          )
        }
        {
          project.role && (
            <div class="meta-row">
              <dt>Role</dt>
              <dd>{project.role}</dd>
            </div>
          )
        }
        {
          project.tools && project.tools.length > 0 && (
            <div class="meta-row">
              <dt>Tools</dt>
              <dd>{project.tools.join(", ")}</dd>
            </div>
          )
        }
        {
          project.status && (
            <div class="meta-row">
              <dt>Status</dt>
              <dd class={`status-value ${stageClass}`}>{project.status}</dd>
            </div>
          )
        }
      </dl>

      {
        sections.length > 0 ? (
          sectionsBefore.map((sec) => (
            <div class="detail-section">
              {sec.title && <h2 class="detail-section-title">{sec.title}</h2>}
              {sec.body && !sec.bodyBelow && (
                <p class="detail-section-body">{sec.body}</p>
              )}
              <div class="detail-gallery">
                {sec.images.map((image) => (
                  <figure class="gallery-item">
                    {image.type === "video" ? (
                      <video src={image.src} controls muted playsinline preload="metadata" />
                    ) : (
                      <img src={image.src} alt={image.caption} loading="lazy" />
                    )}
                    <figcaption>{image.caption}</figcaption>
                  </figure>
                ))}
              </div>
              {sec.body && sec.bodyBelow && (
                <p class="detail-section-body detail-section-body-below">{sec.body}</p>
              )}
            </div>
          ))
        ) : project.images && project.images.length > 0 ? (
          <div class="detail-gallery">
            {project.images.map((image) => (
              <figure class="gallery-item">
                {image.type === "video" ? (
                  <video src={image.src} controls muted playsinline preload="metadata" />
                ) : (
                  <img src={image.src} alt={image.caption} loading="lazy" />
                )}
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <div class="detail-thumb">Project images coming soon</div>
        )
      }

      <div class="detail-body">
        {paragraphs.map((para) => <p>{para}</p>)}
      </div>

      {
        sectionsAfter.map((sec) => (
          <div class="detail-section">
            {sec.title && <h2 class="detail-section-title">{sec.title}</h2>}
            {sec.body && !sec.bodyBelow && (
              <p class="detail-section-body">{sec.body}</p>
            )}
            <div class="detail-gallery">
              {sec.images.map((image) => (
                <figure class="gallery-item">
                  {image.type === "video" ? (
                    <video src={image.src} controls muted playsinline preload="metadata" />
                  ) : (
                    <img src={image.src} alt={image.caption} loading="lazy" />
                  )}
                  <figcaption>{image.caption}</figcaption>
                </figure>
              ))}
            </div>
            {sec.body && sec.bodyBelow && (
              <p class="detail-section-body detail-section-body-below">{sec.body}</p>
            )}
          </div>
        ))
      }

      {
        project.log && project.log.length > 0 && (
          <div class="detail-block">
            <span class="block-label">Build Log</span>
            <ul class="build-log">
              {project.log.map((entry) => (
                <li class="log-row">
                  <span class="log-date">{entry.date}</span>
                  <span class="log-text">{entry.text}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        project.components && project.components.length > 0 && (
          <div class="detail-block">
            <span class="block-label">Key Components</span>
            <table class="bom">
              <thead>
                <tr>
                  <th>Part</th>
                  <th>Role</th>
                </tr>
              </thead>
              <tbody>
                {project.components.map((c) => (
                  <tr>
                    <td>{c.part}</td>
                    <td>{c.role}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .project-detail {
    max-width: 760px; /* narrower column keeps long text readable */
  }
  .back-link {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .detail-title {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
    margin-top: 1rem;
  }
  .status-badge {
    margin-top: 0.75rem;
  }

  /* ----- Metadata strip: instrument readout panel ----- */
  .meta-strip {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: grid;
    gap: 0.75rem;
  }
  .meta-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .meta-row dt {
    font-family: var(--font-mono);
    font-size: 0.656rem; /* 10.5px */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-lo);
    font-weight: 500;
  }
  .meta-row dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.90625rem; /* 14.5px */
    color: var(--text-hi);
    line-height: 1.5;
  }
  @media (max-width: 480px) {
    .meta-row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .project-tags {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .project-tags li {
    font-family: var(--font-mono);
    font-size: 0.656rem; /* 10.5px */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-lo);
    background: rgba(46, 139, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.22rem 0.5rem;
    transition: border-color 0.2s ease;
  }
  .project-tags li:hover {
    border-color: var(--accent);
  }

  .detail-thumb {
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: grid;
    place-items: center;
    color: var(--text-lo);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-block: 2rem;
  }

  /* ----- Image gallery ----- */
  /* ----- Titled content section (heading + body + its own image grid) ----- */
  .detail-section {
    margin-block: 2.5rem;
  }
  .detail-section-title {
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }
  .detail-section-body {
    font-size: 1.1rem;
    max-width: 72ch;
    margin-bottom: 1.5rem;
  }
  /* when the body sits below the images, flip the spacing to the top */
  .detail-section-body-below {
    margin-top: 1.5rem;
    margin-bottom: 0;
  }
  /* the section provides its own outer spacing, so reset the inner gallery */
  .detail-section .detail-gallery {
    margin-block: 0;
  }

  .detail-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-block: 2rem;
  }
  .gallery-item {
    margin: 0;
  }
  .gallery-item img,
  .gallery-item video {
    width: 100%;
    display: block;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface-1);
  }
  /* Cap the (portrait) video height so it doesn't tower over the image cells */
  .gallery-item video {
    max-height: 70vh;
    object-fit: contain;
  }
  .gallery-item figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-lo);
  }
  @media (max-width: 640px) {
    .detail-gallery {
      grid-template-columns: 1fr;
    }
  }

  .detail-body p {
    font-size: 1.1rem;
    margin-bottom: 1.1rem;
  }
  .detail-body p:last-child {
    margin-bottom: 0;
  }

  /* ----- Reference blocks: Build Log + Key Components ----- */
  .detail-block {
    margin-top: 2.5rem;
  }
  .block-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.656rem; /* 10.5px */
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-lo);
    margin-bottom: 1rem;
  }

  /* Build log */
  .build-log {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .log-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .log-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-lo);
  }
  .log-text {
    font-size: 0.9375rem; /* 15px */
    color: var(--text-mid);
    line-height: 1.5;
  }

  /* Key components (BOM) table */
  .bom {
    width: 100%;
    border-collapse: collapse;
  }
  .bom th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.656rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-lo);
    font-weight: 500;
    padding: 0 1rem 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .bom td {
    font-size: 0.90625rem; /* 14.5px */
    color: var(--text-mid);
    padding: 0.65rem 1rem 0.65rem 0;
    border-bottom: 1px solid var(--border);
  }
  .bom td:first-child {
    color: var(--text-hi);
  }

  @media (max-width: 480px) {
    .log-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
