---
// A PROJECT DETAIL PAGE — written once as a template. The [slug] in the
// filename makes this a "dynamic route": Astro generates one page per project.

import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// `description` may be a single string or an array of paragraphs. Normalize to
// an array here so the template can just loop over it either way.
const paragraphs = Array.isArray(project.description)
  ? project.description
  : [project.description];
---

<Base title={`${project.title} — Nick Carpenter`}>
  <section class="section">
    <div class="container project-detail">
      <a class="back-link" href="/projects">← Back to Projects</a>

      <h1 class="detail-title">{project.title}</h1>

      {project.badge && <span class="status-badge">{project.badge}</span>}

      {
        project.tags && project.tags.length > 0 && (
          <ul class="project-tags">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }

      <!-- Compact metadata strip: small labels, folds in Tools and Status -->
      <dl class="meta-strip">
        {
          project.type && (
            <div class="meta-row">
              <dt>Type</dt>
              <dd>{project.type}</dd>
            </div>
          )
        }
        {
          project.role && (
            <div class="meta-row">
              <dt>Role</dt>
              <dd>{project.role}</dd>
            </div>
          )
        }
        {
          project.tools && project.tools.length > 0 && (
            <div class="meta-row">
              <dt>Tools</dt>
              <dd>{project.tools.join(", ")}</dd>
            </div>
          )
        }
        {
          project.status && (
            <div class="meta-row">
              <dt>Status</dt>
              <dd>{project.status}</dd>
            </div>
          )
        }
      </dl>

      {
        project.sections && project.sections.length > 0 ? (
          project.sections.map((sec) => (
            <div class="detail-section">
              {sec.title && <h2 class="detail-section-title">{sec.title}</h2>}
              {sec.body && <p class="detail-section-body">{sec.body}</p>}
              <div class="detail-gallery">
                {sec.images.map((image) => (
                  <figure class="gallery-item">
                    {image.type === "video" ? (
                      <video src={image.src} controls muted playsinline preload="metadata" />
                    ) : (
                      <img src={image.src} alt={image.caption} loading="lazy" />
                    )}
                    <figcaption>{image.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        ) : project.images && project.images.length > 0 ? (
          <div class="detail-gallery">
            {project.images.map((image) => (
              <figure class="gallery-item">
                {image.type === "video" ? (
                  <video src={image.src} controls muted playsinline preload="metadata" />
                ) : (
                  <img src={image.src} alt={image.caption} loading="lazy" />
                )}
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <div class="detail-thumb">Project images coming soon</div>
        )
      }

      <div class="detail-body">
        {paragraphs.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .project-detail {
    max-width: 760px; /* narrower column keeps long text readable */
  }
  .back-link {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .detail-title {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
    margin-top: 1rem;
  }
  .status-badge {
    margin-top: 0.75rem;
  }

  /* ----- Compact metadata strip ----- */
  .meta-strip {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: 0.65rem;
  }
  .meta-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .meta-row dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    font-weight: 500;
  }
  .meta-row dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  @media (max-width: 480px) {
    .meta-row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .project-tags {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .project-tags li {
    font-size: 0.75rem;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .detail-thumb {
    aspect-ratio: 16 / 9;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: grid;
    place-items: center;
    color: var(--color-muted);
    margin-block: 2rem;
  }

  /* ----- Image gallery ----- */
  /* ----- Titled content section (heading + body + its own image grid) ----- */
  .detail-section {
    margin-block: 2.5rem;
  }
  .detail-section-title {
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }
  .detail-section-body {
    font-size: 1.1rem;
    max-width: 72ch;
    margin-bottom: 1.5rem;
  }
  /* the section provides its own outer spacing, so reset the inner gallery */
  .detail-section .detail-gallery {
    margin-block: 0;
  }

  .detail-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-block: 2rem;
  }
  .gallery-item {
    margin: 0;
  }
  .gallery-item img,
  .gallery-item video {
    width: 100%;
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  /* Cap the (portrait) video height so it doesn't tower over the image cells */
  .gallery-item video {
    max-height: 70vh;
    object-fit: contain;
  }
  .gallery-item figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .detail-gallery {
      grid-template-columns: 1fr;
    }
  }

  .detail-body p {
    font-size: 1.1rem;
    margin-bottom: 1.1rem;
  }
  .detail-body p:last-child {
    margin-bottom: 0;
  }
</style>
