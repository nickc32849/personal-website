---
// A PROJECT DETAIL PAGE — written once as a template. The [slug] in the
// filename makes this a "dynamic route": Astro generates one page per project.

import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// `description` may be a single string or an array of paragraphs. Normalize to
// an array here so the template can just loop over it either way.
const paragraphs = Array.isArray(project.description)
  ? project.description
  : [project.description];
---

<Base title={`${project.title} — Nick Carpenter`}>
  <section class="section">
    <div class="container project-detail">
      <a class="back-link" href="/projects">← Back to Projects</a>

      <h1 class="detail-title">{project.title}</h1>

      {project.badge && <span class="status-badge">{project.badge}</span>}

      {project.status && <p class="detail-status">{project.status}</p>}

      {
        project.tags && project.tags.length > 0 && (
          <ul class="project-tags">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }

      {
        project.images && project.images.length > 0 ? (
          <div class="detail-gallery">
            {project.images.map((image) => (
              <figure class="gallery-item">
                <img src={image.src} alt={image.caption} loading="lazy" />
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <div class="detail-thumb">Project images coming soon</div>
        )
      }

      <div class="detail-body">
        {paragraphs.map((para) => <p>{para}</p>)}
      </div>

      {
        project.tools && project.tools.length > 0 && (
          <div class="detail-tools">
            <h2 class="tools-title">Tools</h2>
            <ul class="tool-pills">
              {project.tools.map((tool) => <li>{tool}</li>)}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .project-detail {
    max-width: 760px; /* narrower column keeps long text readable */
  }
  .back-link {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .detail-title {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
    margin-top: 1rem;
  }
  .status-badge {
    margin-top: 0.75rem;
  }
  .detail-status {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .project-tags {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .project-tags li {
    font-size: 0.75rem;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .detail-thumb {
    aspect-ratio: 16 / 9;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: grid;
    place-items: center;
    color: var(--color-muted);
    margin-block: 2rem;
  }

  /* ----- Image gallery ----- */
  .detail-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-block: 2rem;
  }
  .gallery-item {
    margin: 0;
  }
  .gallery-item img {
    width: 100%;
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .gallery-item figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .detail-gallery {
      grid-template-columns: 1fr;
    }
  }

  .detail-body p {
    font-size: 1.1rem;
    margin-bottom: 1.1rem;
  }
  .detail-body p:last-child {
    margin-bottom: 0;
  }

  /* ----- Tools ----- */
  .detail-tools {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .tools-title {
    font-size: 1.1rem;
    margin-bottom: 0.9rem;
  }
  .tool-pills {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tool-pills li {
    font-size: 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
</style>
