---
// THE ABOUT PAGE — served at "/about" (file name = route).

import Base from "../layouts/Base.astro";

// Swap your real portrait here (same idea as the Home page).
const portraitImage = "/portrait.jpg";

// Quick facts shown next to your bio. Edit the text freely.
const quickFacts = [
  { label: "School", value: "Northeastern University" },
  { label: "Major", value: "BS Electrical Engineering" },
  { label: "Minors", value: "Mechanical Engineering · Business Administration" },
  { label: "Class of", value: "2029" },
];

// SKILLS — grouped into categories. Add/remove groups or items freely;
// the page loops over whatever is here. (These are placeholders.)
const skillGroups = [
  { name: "Hardware", items: ["Circuit design", "Analog design", "PCB design", "Soldering", "Oscilloscope", "DMMs", "Network Analyzers", "Raspberry Pi", "Arduino"] },
  { name: "Software", items: ["Python", "MicroPython", "C/C++", "MATLAB"] },
  { name: "Tools", items: ["LTspice", "KiCad", "OrCAD", "Altium", "Git", "SolidWorks"] },
];

// Honors and involvement, split into two groups (kept short, no descriptions).
const honors = [
  "IEEE-HKN (Treasurer)",
  "Tau Beta Pi",
  "John Martinson Honors Program",
  "Dean's List",
];
const involvement = [
  "Forge Hardware Product Lab",
  "Engineers Without Borders",
  "Entrepreneurs Club Oakland (2nd place in Husky Startup Challenge)",
  "IEEE",
  "Global Scholars Program: NU Oakland (Fall 2024), NU London (Spring 2025)",
];
---

<Base title="About — Nick Carpenter">
  <!-- ===== Bio + portrait + quick facts ===== -->
  <section class="section">
    <div class="container about-header">
      <img class="about-photo" src={portraitImage} alt="Nick Carpenter" />

      <div class="about-text">
        <span class="kicker">01 // ABOUT</span>
        <h1 class="page-title">About</h1>

        <p>
          I'm Nick, a third-year Electrical Engineering student at Northeastern
          University, with minors in Mechanical Engineering and Business
          Administration. I spent my early years in Seattle, where being close
          to the aerospace industry sparked my interest in planes, space, and
          how machines work. That curiosity stuck with me. I've always wanted to
          understand things from the inside out, which is why I'm studying
          electrical engineering. I want to build things, not just talk about
          them.
        </p>
        <p>
          Right now, I'm interested in tough problems in energy, space, lasers,
          and electric vehicles. I want to build hardware that people can really
          rely on. Outside of engineering, I enjoy reading, working out, spending
          time outdoors, traveling, and trying new things.
        </p>

        <ul class="facts">
          {
            quickFacts.map((fact) => (
              <li>
                <span class="fact-label">{fact.label}</span>
                <span class="fact-value">{fact.value}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== Skills ===== -->
  <section class="section skills-section">
    <div class="container">
      <h2 class="section-title">Skills</h2>
      <div class="skills-grid">
        {
          skillGroups.map((group) => (
            <div class="skill-group">
              <h3 class="skill-group-name">{group.name}</h3>
              <ul class="skill-pills">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Honors & Involvement ===== -->
  <section class="section honors-section">
    <div class="container">
      <h2 class="section-title">Honors &amp; Involvement</h2>
      <div class="honors-grid">
        <div class="honors-group">
          <h3 class="honors-group-name">Honors</h3>
          <ul class="honors-list">
            {honors.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="honors-group">
          <h3 class="honors-group-name">Involvement</h3>
          <ul class="honors-list">
            {involvement.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- Bio header ----- */
  .about-header {
    display: grid;
    grid-template-columns: 280px 1fr; /* portrait left, text right */
    gap: 3rem;
    align-items: start;
  }
  .about-photo {
    width: 100%;
    border-radius: 4px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .page-title {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .about-text p {
    font-size: 1.1rem;
    max-width: 60ch;
    margin-bottom: 1rem;
  }

  /* Quick facts list */
  .facts {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }
  .facts li {
    display: flex;
    gap: 0.75rem;
  }
  .fact-label {
    min-width: 90px;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .fact-value {
    font-size: 0.95rem;
  }

  /* Stack on narrow screens */
  @media (max-width: 720px) {
    .about-header {
      grid-template-columns: 1fr;
    }
    .about-photo {
      max-width: 280px;
    }
  }

  /* ----- Skills + Honors: instrument spec panels ----- */
  .skills-grid,
  .honors-grid {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .skill-group-name,
  .honors-group-name {
    font-family: var(--font-mono);
    font-size: 0.656rem; /* 10.5px */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-lo);
    margin-bottom: 0.9rem;
  }
  .skill-pills,
  .honors-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .skill-pills li,
  .honors-list li {
    font-size: 0.90625rem; /* 14.5px */
    color: var(--text-hi);
    line-height: 1.45;
  }
</style>
