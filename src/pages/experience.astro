---
// THE EXPERIENCE PAGE — served at "/experience".
// Leads with the embedded resume (PDF viewer + download button), then shows
// the timeline of roles from src/data/experience.js.

import Base from "../layouts/Base.astro";
import { experiences } from "../data/experience.js";

// Your resume file. Put your PDF at public/resume.pdf (overwrite the
// placeholder). To use a different name, drop it in /public and change this.
const resumeFile = "/resume.pdf";
---

<Base title="Experience — Nick Carpenter">
  <!-- ===== Resume (embedded viewer + download) ===== -->
  <section class="section">
    <div class="container">
      <div class="resume-header">
        <h1 class="page-title">Resume</h1>
        <a class="btn btn-primary" href={resumeFile} download>Download PDF ↓</a>
      </div>

      <div class="resume-viewer">
        <iframe src={resumeFile} title="Nick Carpenter — Resume"></iframe>
      </div>
      <p class="resume-fallback">
        Can't see the resume above?
        <a href={resumeFile} download>Download the PDF</a>.
      </p>
    </div>
  </section>

  <!-- ===== Experience timeline ===== -->
  <section class="section timeline-section">
    <div class="container">
      <h2 class="section-title">Experience</h2>

      <div class="timeline">
        {
          experiences.map((exp) => (
            <div class="timeline-item">
              <p class="timeline-dates">{exp.dates}</p>
              <h3 class="timeline-role">{exp.role}</h3>
              <p class="timeline-org">
                {exp.organization}
                {exp.location && ` · ${exp.location}`}
              </p>
              <ul class="timeline-bullets">
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .page-title {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
  }

  /* ----- Resume ----- */
  .resume-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .resume-viewer {
    width: 100%;
    height: 85vh; /* tall enough to read a page; scrolls inside */
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }
  .resume-viewer iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .resume-fallback {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .resume-fallback a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ----- Timeline ----- */
  .timeline-section {
    border-top: 1px solid var(--color-border);
  }
  .timeline {
    border-left: 2px solid var(--color-border);
    margin-left: 0.5rem;
  }
  .timeline-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 2.75rem;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-item::before {
    content: "";
    position: absolute;
    left: -8px;
    top: 0.4rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
  }
  .timeline-dates {
    font-size: 0.85rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .timeline-role {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    margin-top: 0.15rem;
  }
  .timeline-org {
    color: var(--color-accent);
    font-size: 0.95rem;
    margin-top: 0.1rem;
  }
  .timeline-bullets {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
  .timeline-bullets li {
    font-size: 1rem;
    line-height: 1.55;
  }
</style>
