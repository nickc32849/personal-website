---
// THE EXPERIENCE PAGE — served at "/experience".
// Leads with the embedded resume (PDF viewer + download button), then shows
// the timeline of roles from src/data/experience.js.

import Base from "../layouts/Base.astro";
import { experiences } from "../data/experience.js";

// Your resume file. Put your PDF at public/resume.pdf (overwrite the
// placeholder). To use a different name, drop it in /public and change this.
const resumeFile = "/resume.pdf";
---

<Base title="Experience — Nick Carpenter">
  <!-- ===== Resume (embedded viewer + download) ===== -->
  <section class="section">
    <div class="container">
      <div class="resume-header">
        <h1 class="page-title">Resume</h1>
        <a class="btn btn-primary" href={resumeFile} download>Download PDF ↓</a>
      </div>

      <div class="resume-viewer">
        <iframe src={resumeFile} title="Nick Carpenter — Resume"></iframe>
      </div>
      <p class="resume-fallback">
        Can't see the resume above?
        <a href={resumeFile} download>Download the PDF</a>.
      </p>
    </div>
  </section>

  <!-- ===== Experience timeline ===== -->
  <section class="section timeline-section">
    <div class="container">
      <h2 class="section-title">Experience</h2>

      <div class="timeline">
        {
          experiences.map((exp) => (
            <div class="timeline-item">
              <p class="timeline-dates">{exp.dates}</p>
              <h3 class="timeline-role">{exp.role}</h3>
              <p class="timeline-org">
                {exp.organization}
                {exp.location && ` · ${exp.location}`}
              </p>
              {exp.prose &&
                exp.prose.map((para) => <p class="timeline-prose">{para}</p>)}
              <ul class="timeline-bullets">
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
              {exp.links && (
                <div class="timeline-links">
                  <span class="timeline-links-label">{exp.links.label}</span>
                  <div class="link-card-row">
                    {exp.links.items.map((link) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener"
                        class="link-card"
                      >
                        {link.thumb && (
                          <img
                            class="link-card-thumb"
                            src={link.thumb}
                            alt=""
                            loading="lazy"
                          />
                        )}
                        <span class="link-card-text">
                          <span class="link-card-title">{link.text}</span>
                          {link.source && (
                            <span class="link-card-source">{link.source}</span>
                          )}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .page-title {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
  }

  /* ----- Resume ----- */
  .resume-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .resume-viewer {
    width: 100%;
    height: 85vh; /* tall enough to read a page; scrolls inside */
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }
  .resume-viewer iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .resume-fallback {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .resume-fallback a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ----- Timeline ----- */
  .timeline-section {
    border-top: 1px solid var(--color-border);
  }
  .timeline {
    border-left: 2px solid var(--color-border);
    margin-left: 0.5rem;
  }
  .timeline-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 2.75rem;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-item::before {
    content: "";
    position: absolute;
    left: -8px;
    top: 0.4rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
  }
  .timeline-dates {
    font-size: 0.85rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .timeline-role {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    margin-top: 0.15rem;
  }
  .timeline-org {
    color: var(--color-accent);
    font-size: 0.95rem;
    margin-top: 0.1rem;
  }
  .timeline-prose {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.55;
    max-width: 72ch;
  }
  .timeline-bullets {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
  .timeline-bullets li {
    font-size: 1rem;
    line-height: 1.55;
  }

  /* ----- "Read and hear more" link-preview cards ----- */
  .timeline-links {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .timeline-links-label {
    font-weight: 500;
    color: var(--color-muted);
  }
  .link-card-row {
    margin-top: 0.6rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 640px;
  }
  .link-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .link-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.06);
  }
  .link-card-thumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .link-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .link-card-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.3;
  }
  .link-card-source {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .link-card-row {
      grid-template-columns: 1fr;
    }
  }
</style>
