---
// THE EXPERIENCE PAGE — served at "/experience".
// Leads with the embedded resume (panel + download), then a numbered timeline
// of roles from src/data/experience.js.

import Base from "../layouts/Base.astro";
import { experiences } from "../data/experience.js";

// Your resume file. Put your PDF at public/resume.pdf and it flows through here.
const resumeFile = "/resume.pdf";
---

<Base title="Experience — Nick Carpenter">
  <!-- ===== Resume panel ===== -->
  <section class="section">
    <div class="container">
      <span class="kicker">01 // RESUME</span>

      <div class="resume-panel">
        <div class="resume-panel-head">
          <span class="resume-panel-label">Resume</span>
          <a class="ghost-pill" href={resumeFile} download>Download PDF ↓</a>
        </div>
        <div class="resume-viewer">
          <iframe
            src={resumeFile}
            title="Nick Carpenter — Resume"
            loading="lazy"></iframe>
        </div>
      </div>
      <p class="resume-fallback">
        Can't see the resume above?{" "}
        <a href={resumeFile} download>Download the PDF</a>.
      </p>
    </div>
  </section>

  <!-- ===== Experience timeline ===== -->
  <section class="section timeline-section">
    <div class="container">
      <span class="kicker">02 // EXPERIENCE</span>
      <h1 class="section-title">Experience</h1>

      <div class="timeline">
        {
          experiences.map((exp, i) => (
            <div class="timeline-item">
              <span class="timeline-index">{String(i + 1).padStart(2, "0")}</span>
              <p class="timeline-dates">{exp.dates}</p>
              <h2 class="timeline-role">{exp.role}</h2>
              <p class="timeline-org">
                {exp.organization}
                {exp.location && ` · ${exp.location}`}
              </p>
              {exp.prose &&
                exp.prose.map((para) => <p class="timeline-prose">{para}</p>)}
              <ul class="timeline-bullets">
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
              {exp.links && (
                <div class="timeline-links">
                  <span class="timeline-links-label">{exp.links.label}</span>
                  <div class="link-card-row">
                    {exp.links.items.map((link) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener"
                        class="link-card"
                      >
                        {link.thumb && (
                          <img
                            class="link-card-thumb"
                            src={link.thumb}
                            alt=""
                            loading="lazy"
                          />
                        )}
                        <span class="link-card-text">
                          <span class="link-card-title">{link.text}</span>
                          {link.source && (
                            <span class="link-card-source">{link.source}</span>
                          )}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .section-title {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
    color: var(--text-hi);
  }

  /* ----- Resume panel ----- */
  .resume-panel {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .resume-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .resume-panel-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-lo);
  }
  .ghost-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.45rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-mid);
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .ghost-pill:hover {
    border-color: var(--accent);
    color: var(--text-hi);
  }
  .resume-viewer {
    width: 100%;
    height: 82vh; /* tall enough to read a page; scrolls inside */
    background: var(--surface-2);
  }
  .resume-viewer iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .resume-fallback {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-lo);
  }
  .resume-fallback a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ----- Numbered timeline ----- */
  .timeline {
    border-left: 1px solid var(--border);
    margin-left: 0.5rem;
  }
  .timeline-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 2.75rem;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  /* accent-ringed dot on the rule */
  .timeline-item::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 0.35rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .timeline-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .timeline-dates {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-lo);
  }
  .timeline-role {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--text-hi);
    margin-top: 0.2rem;
  }
  .timeline-org {
    color: var(--accent);
    font-size: 0.95rem;
    margin-top: 0.1rem;
  }
  .timeline-prose {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.55;
    max-width: 72ch;
    color: var(--text-mid);
  }
  .timeline-bullets {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
  .timeline-bullets li {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-mid);
  }

  /* ----- "Read and hear more" press cards ----- */
  .timeline-links {
    margin-top: 1.25rem;
  }
  .timeline-links-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-lo);
    margin-bottom: 0.6rem;
  }
  .link-card-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 640px;
  }
  .link-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface-1);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .link-card:hover {
    transform: translateY(-4px);
    border-color: rgba(46, 139, 255, 0.55);
    box-shadow: 0 0 0 1px rgba(46, 139, 255, 0.25),
      0 16px 40px rgba(0, 0, 0, 0.45);
  }
  .link-card-thumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 4px;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--surface-2);
    /* logos monochrome by default; full color on hover */
    filter: grayscale(1) contrast(1.05) brightness(0.95);
    transition: filter 0.2s ease;
  }
  .link-card:hover .link-card-thumb {
    filter: grayscale(0);
  }
  .link-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .link-card-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-hi);
    line-height: 1.3;
  }
  .link-card-source {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-lo);
  }
  @media (max-width: 640px) {
    .link-card-row {
      grid-template-columns: 1fr;
    }
  }
</style>
