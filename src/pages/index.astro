---
// THE HOME PAGE.  Named index.astro inside src/pages/, so Astro serves it at "/".

import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects.js";

// =====================================================================
//  IMAGE PLACEHOLDERS — the two spots to swap your real photos.
//  Files live in the /public folder. To use your own photo:
//    1. Drop your image into the /public folder (e.g. public/hero.jpg)
//    2. Change the path below to match (e.g. "/hero.jpg")
//  (Paths start with "/" which means "the public folder".)
// =====================================================================
const heroImage = "/hero-placeholder.svg"; // #1 — full-screen background photo
const portraitImage = "/portrait-placeholder.svg"; // #2 — photo in the intro section

// Show only the projects marked `featured: true` in src/data/projects.js
const featuredProjects = projects.filter((project) => project.featured);
---

<Base title="Nick Carpenter — Electrical Engineering">
  <!-- ===== 1. HERO — full-screen background photo + overlaid name ===== -->
  <section class="hero" style={`background-image: url('${heroImage}')`}>
    <div class="container hero-content">
      <h1 class="hero-name">Nick Carpenter</h1>
      <p class="hero-line">Electrical Engineering @ Northeastern</p>
    </div>
  </section>

  <!-- ===== 2. INTRO — paragraph beside a portrait photo ===== -->
  <section id="intro" class="section">
    <div class="container intro-grid">
      <img class="intro-photo" src={portraitImage} alt="Nick Carpenter" />
      <div class="intro-text">
        <h2 class="section-title">About</h2>
        <p class="intro">
          [Placeholder intro — a short paragraph about who you are, what you're
          studying, and what kind of co-op or work you're looking for. We'll
          write this together.]
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 3. BUTTON ROW ===== -->
  <section class="button-section">
    <div class="container">
      <div class="button-row">
        <a class="btn btn-primary" href="/about">About</a>
        <a class="btn" href="/experience">Experience</a>
        <a class="btn" href="/projects">Projects</a>
      </div>
    </div>
  </section>

  <!-- ===== 4. FEATURED PROJECTS (unchanged) ===== -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Featured Projects</h2>
      <div class="project-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- Hero ----- */
  .hero {
    position: relative; /* lets the dark overlay position itself over the photo */
    min-height: calc(100vh - 64px); /* fill the screen below the 64px nav */
    display: flex;
    align-items: center; /* vertical centering */
    justify-content: center; /* horizontal centering */
    text-align: center; /* center the name + tagline text */
    padding-block: 4rem;
    background-size: cover; /* photo fills the area, cropping as needed */
    background-position: center;
    overflow: hidden;
  }
  /* The subtle dark overlay: a full-cover layer between photo and text so
     light text stays readable no matter what the photo looks like. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25),
      rgba(0, 0, 0, 0.55)
    );
  }
  .hero-content {
    position: relative;
    z-index: 1; /* sit ABOVE the ::after overlay */
    color: #fff;
  }
  .hero-name {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1.03;
    color: #fff;
  }
  .hero-line {
    margin-top: 0.75rem;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ----- Intro (text + portrait side by side) ----- */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr; /* photo left (narrower), text right (wider) */
    gap: 3rem;
    align-items: center;
  }
  .intro {
    font-size: 1.15rem;
    max-width: 55ch;
  }
  .intro-photo {
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5; /* portrait shape */
    object-fit: cover; /* crop to fill without distortion */
  }
  /* Stack them vertically on narrow screens */
  @media (max-width: 720px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-photo {
      max-width: 320px;
    }
  }

  /* ----- Button row (its own band, no big top gap after intro) ----- */
  .button-section {
    padding-bottom: 2rem;
  }
  .button-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ----- Featured projects grid (card styles live in ProjectCard.astro) ----- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
</style>
