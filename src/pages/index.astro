---
// THE HOME PAGE.  Named index.astro inside src/pages/, so Astro serves it at "/".

import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects.js";

// Show only the projects marked `featured: true` in src/data/projects.js
const featuredProjects = projects.filter((project) => project.featured);
---

<Base title="Nick Carpenter">
  <!-- ===== 1. HERO: dark, blueprint grid, left-aligned ===== -->
  <section class="hero">
    <div class="container hero-content">
      <span class="hero-eyebrow">
        Electrical Engineering // Northeastern University
      </span>
      <h1 class="hero-name">Nick Carpenter</h1>
      <p class="hero-line">
        Drawn to the hard problems in energy, space, lasers, and EVs, and
        building hardware people can genuinely depend on.
      </p>
      <p class="hero-note">
        Currently on co-op at CPI Electron Device Business and building a
        self-balancing robot from scratch.
      </p>
      <div class="hero-actions">
        <a class="pill" href="/about">About</a>
        <a class="pill" href="/experience">Experience</a>
        <a class="pill" href="/projects">View Projects</a>
      </div>
    </div>

    <!-- Oscilloscope trace: draws in once (~6s). The site's only non-hover
         animation; disabled under prefers-reduced-motion. -->
    <svg
      class="scope"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        class="scope-trace"
        d="M0,70 H120 V40 H260 V100 H400 V40 H540 V100 H680 V70 H820 V45 H960 V95 H1100 V70 H1200"
      ></path>
    </svg>
  </section>

  <!-- ===== 2. FEATURED PROJECTS ===== -->
  <section class="section">
    <div class="container">
      <span class="kicker">01 // FEATURED PROJECTS</span>
      <h2 class="section-title">Featured Projects</h2>
      <div class="project-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- Hero ----- */
  .hero {
    position: relative;
    min-height: calc(100vh - 64px); /* fill the screen below the 64px nav */
    display: flex;
    align-items: center; /* vertical center */
    padding-block: 4rem;
    background: var(--bg);
    background-image: var(--grid-bg);
    background-size: var(--grid-size) var(--grid-size);
    overflow: hidden;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: left;
  }
  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .hero-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: -0.02em;
    line-height: 1.03;
    color: var(--text-hi);
  }
  .hero-line {
    margin-top: 1.25rem;
    max-width: 52ch;
    font-size: 1.25rem; /* 20px */
    color: var(--text-mid);
  }
  .hero-note {
    margin-top: 0.85rem;
    max-width: 52ch;
    font-size: 0.9375rem; /* 15px */
    color: var(--text-mid);
  }

  /* Ghost pill buttons */
  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 0.8125rem; /* 13px */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.65rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-mid);
    background: transparent;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .pill:hover {
    border-color: var(--accent);
    color: var(--text-hi);
  }

  /* Oscilloscope trace along the lower hero */
  .scope {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8%;
    width: 100%;
    height: 120px;
    z-index: 0;
    pointer-events: none;
  }
  .scope-trace {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    opacity: 0.45;
    stroke-dasharray: 4000;
    stroke-dashoffset: 4000;
    animation: scope-draw 6s ease-out forwards;
  }
  @keyframes scope-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* Show the trace statically for reduced-motion users (no draw-in). */
  @media (prefers-reduced-motion: reduce) {
    .scope-trace {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  /* hairline divider between hero and Featured Projects */
  .hero + .section {
    border-top: 1px solid var(--border);
  }

  /* ----- Featured projects grid (card styles live in ProjectCard.astro) ----- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
</style>
